{
  "name": "api2sdk",
  "version": "1.0.0",
  "description": "Hey API client that sends generated OpenAPI SDK requests with grab instead of axios or fetch, adding caching, retries, rate limiting, deduplication and mocks.",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "api2sdk": "./dist/cli.es.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config vite.config.ts"
  },
  "keywords": [
    "openapi",
    "swagger",
    "hey-api",
    "heyapi",
    "api2sdk",
    "codegen",
    "client",
    "sdk",
    "grab",
    "fetch",
    "axios",
    "typescript",
    "rest",
    "fumadocs",
    "scalar",
    "docs"
  ],
  "dependencies": {
    "grab-url": "^1.6.22"
  },
  "peerDependencies": {
    "@hey-api/openapi-ts": ">=0.60.0",
    "@scalar/cli": ">=2.0.0",
    "fumadocs-core": ">=16.0.0",
    "fumadocs-openapi": ">=10.0.0",
    "fumadocs-ui": ">=16.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@hey-api/openapi-ts": {
      "optional": true
    },
    "@scalar/cli": {
      "optional": true
    },
    "fumadocs-core": {
      "optional": true
    },
    "fumadocs-openapi": {
      "optional": true
    },
    "fumadocs-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "author": "vtempest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vtempest/GRAB-URL.git",
    "directory": "packages/api2sdk"
  },
  "bugs": {
    "url": "https://github.com/vtempest/GRAB-URL/issues"
  },
  "homepage": "https://github.com/vtempest/GRAB-URL/tree/master/packages/api2sdk#readme"
}
